# Copiez ce fichier en ".env.local" et remplissez avec vos clés Supabase.
# Sans ces variables, le site fonctionne quand même avec les produits de démonstration
# (voir lib/data.js), mais rien n'est persistant (pas de vraie base de données).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SenePay — paiement Mobile Money (Orange Money, Moov Africa, Wave...)
# Récupérez ces clés sur votre tableau de bord SenePay (sene-pay.com) une fois
# votre compte marchand validé. Utilisez les clés "test" (pk_test_/sk_test_)
# pour développer, puis les clés "live" (pk_live_/sk_live_) en production.
SENEPAY_API_KEY=
SENEPAY_API_SECRET=
# Retourné une seule fois à la création de vos clés API — sert à vérifier
# l'authenticité des webhooks de paiement.
SENEPAY_WEBHOOK_SECRET=

# URL publique de votre site, utilisée pour construire les liens de retour
# après paiement (ex: https://diakoboulon.com). En local, laissez la valeur
# par défaut ci-dessous.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

